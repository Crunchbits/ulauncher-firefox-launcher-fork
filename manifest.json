{
    "required_api_version": "^2.0.0",
    "name": "Firefox Launcher Fork",
    "description": "Open websites in Firefox",
    "developer_name": "Robin Strehlow, Riccardo Massidda",
    "icon": "images/icon.png",
    "options": {
      "query_debounce": 0.1
    },
    "preferences": [
      {
        "id": "kw",
        "type": "keyword",
        "name": "Firefox Launcher",
        "description": "Open websites in Firefox",
        "default_value": "ff"
      },
      {
        "id": "order",
        "type": "select",
        "name": "History results order",
        "default_value": "frecency",
        "options":[
          {"value":"frecency","text":"Firefox Frecency"},
          {"value":"visit","text":"Visit Count"},
          {"value":"recent","text":"Last Visit"}
        ]
      },  
      {
        "id": "limit",
        "type": "input",
        "name": "History results number",
        "default_value": "5"
      },
      {
        "id": "custom_path",
        "type": "input",
        "name": "Custom Firefox Directory",
        "description": "Leave blank for default. Supply the folder containing profiles.ini OR the direct profile folder.",
        "default_value": ""
      },
      {
        "id": "enable_bookmarks",
        "type": "select",
        "name": "Enable Bookmarks",
        "default_value": "True",
        "options": [
          {"value": "True", "text": "Yes"},
          {"value": "False", "text": "No"}
        ]
      },
      {
        "id": "enable_history",
        "type": "select",
        "name": "Enable History",
        "default_value": "True",
        "options": [
          {"value": "True", "text": "Yes"},
          {"value": "False", "text": "No"}
        ]
      }
    ]
}
